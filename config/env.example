# Mars plugin configuration.
# Copy to "$(herdr plugin config-dir digitalocean.mars)/.env". Process environment wins over this file.

# doctl binary that has the Managed Agents (harness-runtime) commands.
# Leave empty to auto-detect: doctl-beta first, then doctl.
MARS_DOCTL_BIN=

# Extra directories to search for agent manifests, colon separated.
# The focused pane's directory, its specs/ and .mars/ subdirectories are always searched.
# Default: <config dir>/specs
#MARS_SPEC_DIRS=/home/me/agent-specs:/home/me/work/specs

# Split direction for panes the plugin opens: auto (based on pane shape), right, or down.
MARS_SPLIT_DIRECTION=auto

# Codex proxy defaults for the "proxy" action.
MARS_PROXY_TYPE=codex
MARS_PROXY_PORT=1144
# Start a local Codex agent in a Herdr pane once the proxy is listening (requires the codex CLI).
MARS_PROXY_AUTOSTART_AGENT=1
# Prefix for Herdr agent names created by the proxy action ([a-z][a-z0-9_-]*).
MARS_AGENT_NAME_PREFIX=mars

# Show Herdr notifications after lifecycle actions (0 to disable).
MARS_NOTIFY=1

# Use fzf for pickers when installed: auto, 1, or 0 (numbered menus).
MARS_USE_FZF=auto

# Sessions fetched per list call.
MARS_LIST_PAGE_SIZE=100
