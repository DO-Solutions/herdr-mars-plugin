#!/usr/bin/env bash
# Fake doctl for tests. Records every invocation to $MARS_FAKE_LOG (args joined with "|").
set -uo pipefail

fixtures="$(cd "$(dirname "${BASH_SOURCE[0]}")/../fixtures" && pwd)"
if [[ -n "${MARS_FAKE_LOG:-}" ]]; then
  { printf 'doctl'; printf '|%s' "$@"; printf '\n'; printf 'doctl-cwd|%s\n' "$PWD"; } >>"$MARS_FAKE_LOG"
fi

group="${FAKE_DOCTL_GROUP:-harness-runtime}"

case "${1:-}" in
  version)
    echo "doctl version 1.167.0-beta"
    exit 0
    ;;
  account)
    echo '{"email":"tester@example.com","uuid":"u-1"}'
    exit 0
    ;;
  auth)
    echo "fake-token"
    exit 0
    ;;
esac

if [[ "${1:-}" != "$group" ]]; then
  echo "Error: unknown command \"${1:-}\" for \"doctl\"" >&2
  exit 255
fi
shift

if [[ "${1:-}" == "--help" ]]; then
  echo "Managed Agents Runtime Services (M.A.R.S)"
  exit 0
fi

sub="${1:-}"
shift || true

case "$sub" in
  # Read-only commands always succeed; FAKE_DOCTL_EXIT only affects mutating commands.
  list)
    # The real API returns only live sessions unless --status asks for a specific
    # one, so finished runs are invisible to an unfiltered list. Model that here.
    status=""
    while [[ $# -gt 0 ]]; do
      case "$1" in
        --status) status="${2:-}"; shift 2 ;;
        --status=*) status="${1#--status=}"; shift ;;
        *) shift ;;
      esac
    done
    if [[ -n "$status" ]]; then
      jq --arg s "$status" 'map(select(.status == $s))' "${MARS_FAKE_SESSIONS:-$fixtures/sessions.json}"
    else
      jq 'map(select(.status != "SESSION_STATUS_DESTROYED" and .status != "SESSION_STATUS_FAILED"))' \
        "${MARS_FAKE_SESSIONS:-$fixtures/sessions.json}"
    fi
    exit 0
    ;;
  config)
    configs="${MARS_FAKE_CONFIGS:-$fixtures/configs.json}"
    case "${1:-}" in
      list)
        cat "$configs"
        exit 0
        ;;
      get | show)
        jq --arg id "${2:-}" '.[] | select(.id == $id)
          | . + {content_hash: "abc123", manifest: {name: .name, agent: "opencode", size: "mv-2vcpu-4gb"}}' "$configs"
        exit 0
        ;;
      list-sessions | sessions)
        jq --arg id "${2:-}" 'map(select(.config_id == $id))' "${MARS_FAKE_SESSIONS:-$fixtures/sessions.json}"
        exit 0
        ;;
    esac
    echo "fake doctl config $*"
    ;;
  show)
    jq --arg id "${1:-}" '.[] | select(.session_id == $id)' "${MARS_FAKE_SESSIONS:-$fixtures/sessions.json}"
    exit 0
    ;;
  *)
    echo "fake doctl $group $sub $*"
    ;;
esac
exit "${FAKE_DOCTL_EXIT:-0}"
